0.00000, -1.00000, 0.00000),\n  vec3f(0.00000, -1.00000, 0.00000));\n\nfn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  let i = ctx.index;\n  var fx: u32;\n  var c: u32;\n  if (i < BARS * 48u) { fx = i / 48u; c = i % 48u; }\n  else { let j = i - BARS * 48u; fx = BARS + j / 24u; c = j % 24u; }\n  if (fx >= FIXTURES) { q.tint = vec4f(0.0); q.size = 0.0; return q; }\n  let b = BASE[fx];\n  var local = vec2f(0.0);   // along u, along v (metres)\n  var size = 0.03;\n  var light = vec3f(0.0);\n  if (fx < BARS) {\n    // Acme Pixel Line IP, Mode 10: ch1 master; RGB cell k at 6+3(k-1); white cell k at 101+k.\n    let master = dmxAt(b);\n    if (c < 32u) {\n      let o = b + 5u + 3u * c;\n      light = vec3f(dmxAt(o), dmxAt(o + 1u), dmxAt(o + 2u)) * master;\n      local = vec2f(-0.5 + (f32(c) + 0.5) / 32.0, -0.016);\n      size = 0.029;\n    } else {\n      let k = c - 32u;\n      light = vec3f(dmxAt(b + 101u + k)) * master;\n      local = vec2f(-0.5 + (f32(k) + 0.5) / 16.0, 0.016);\n      size = 0.03;\n    }\n  } else {\n    // GLP JDC Burst 1, Mode 3: RGBW pixel k at 40+4(k-1) under the pixel master (24-25), the\n    // RGBW module (11-12 dimmer, 16-19 colour) over all of it; white pixel k at 27+k under the\n    // white pixel master (20-21), the white module (6-7) over all of it. Layers combine HTP.\n    if (c < 12u) {\n      let o = b + 39u + 4u * c;\n      let w = dmxAt(o + 3u);\n      let cell = (vec3f(dmxAt(o), dmxAt(o + 1u), dmxAt(o + 2u)) + vec3f(w)) * dmx16(b + 23u);\n      let mw = dmxAt(b + 18u);\n      let whole = (vec3f(dmxAt(b + 15u), dmxAt(b + 16u), dmxAt(b + 17u)) + vec3f(mw)) * dmx16(b + 10u);\n      light = max(cell, whole);\n      local = vec2f(-0.15 + 0.06 * f32(c % 6u), select(0.045, -0.045, c < 6u));\n      size = 0.055;\n    } else {\n      let k = c - 12u;\n      light = vec3f(max(dmxAt(b + 27u + k) * dmx16(b + 19u), dmx16(b + 5u)));\n      local = vec2f(-0.165 + 0.03 * f32(k), 0.0);\n      size = 0.028;\n    }\n  }\n  let u = AU[fx];\n  let v = AV[fx];\n  let w = AW[fx];\n  // Cells sit on the face the light leaves from (-w), a little proud of the body.\n  q.position = POS[fx] + u * local.x + v * local.y - w * 0.06;\n  // (u, -v, -w) keeps the frame right-handed with the quad facing out of the light's face.\n  q.orient = quatFromFrame(u, -v, -w);\n  q.size = size;\n  q.tint = vec4f(max(light * ctx.params.gain, vec3f(ctx.params.floorLevel)), 1.0);\n  return q;\n}\n",
