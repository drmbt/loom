vec3f(-0.00000, -0.00100, -1.00000));\n\nfn process(p: Point, ctx: PointCtx) -> Point {\n  var q = p;\n  let h = ctx.index / 2u;\n  let role = ctx.index % 2u;\n  q.role = f32(role);\n  if (h >= HEADS) { q.tint = vec4f(0.0); q.width = 0.0; q.tip = q.position; return q; }\n  let b = BASE[h];\n  var pan = 0.0;\n  var tilt = 0.0;\n  var zoom = 40.0;   // full beam angle, degrees\n  var colour = vec3f(1.0);\n  var dim = 0.0;\n  switch KIND[h] {\n    case 0u: {   // Mac Aura XB, Standard (14): 2 dim, 3 zoom 53->11, 4-5 pan, 6-7 tilt, 10-12 RGB\n      dim = dmxAt(b + 1u);\n      zoom = mix(53.0, 11.0, dmxAt(b + 2u));\n      pan = mix(-270.0, 270.0, dmx16(b + 3u));\n      tilt = mix(-116.0, 116.0, dmx16(b + 5u));\n      colour = vec3f(dmxAt(b + 9u), dmxAt(b + 10u), dmxAt(b + 11u));\n    }\n    case 1u: {   // Proteus Lucius, Standard (43): 1-2 pan, 3-4 tilt, 5-7 CMY, 23-24 zoom, 26-27 dim\n      pan = mix(-270.0, 270.0, dmx16(b));\n      tilt = mix(-125.0, 125.0, dmx16(b + 2u));\n      colour = vec3f(1.0) - vec3f(dmxAt(b + 4u), dmxAt(b + 5u), dmxAt(b + 6u));\n      zoom = mix(5.5, 50.0, dmx16(b + 22u));\n      dim = dmx16(b + 25u);\n    }\n    case 2u: {   // iForte FS, Mode 1 (54): 1-2 pan, 3-4 tilt, 14-16 CMY, 39-40 zoom 55->5, 53-54 dim\n      pan = mix(-270.0, 270.0, dmx16(b));\n      tilt = mix(-135.0, 135.0, dmx16(b + 2u));\n      colour = vec3f(1.0) - vec3f(dmxAt(b + 13u), dmxAt(b + 14u), dmxAt(b + 15u));\n      zoom = mix(55.0, 5.0, dmx16(b + 38u));\n      dim = dmx16(b + 52u);\n    }\n    default: {   // ColorStrobe, Mode 1 (9): 1-4 RGBW, 7 dim; a fixed wide flood\n      colour = vec3f(dmxAt(b), dmxAt(b + 1u), dmxAt(b + 2u)) + vec3f(dmxAt(b + 3u));\n      dim = dmxAt(b + 6u);\n      zoom = 70.0;\n    }\n  }\n  // GDTF: the beam leaves along local -Z at pan = tilt = 0; tilt turns about local X, pan about local Z.\n  let pr = radians(pan);\n  let tr = radians(tilt);\n  let dl = vec3f(-sin(tr) * sin(pr), sin(tr) * cos(pr), -cos(tr));\n  let dir = normalize(AU[h] * dl.x + AV[h] * dl.y + AW[h] * dl.z);\n  var reach = ctx.params.reach;\n  if (KIND[h] == 3u) { reach = 4.0; }\n  if (dir.y < -0.01) { reach = min(reach, (POS[h].y - DECK_Y) / -dir.y); }\n  let light = colour * dim;\n  q.position = POS[h] + dir * 0.18;\n  if (role == 0u) {\n    q.tip = q.position + dir * reach;\n    q.width = reach * tan(radians(zoom) * 0.5);\n    // A wide beam spreads the same light: a flood reads soft, a narrow beam reads as a shaft.\n    q.tint = vec4f(light * ctx.params.beamGain * clamp(14.0 / zoom, 0.12, 1.6), 1.0);\n  } else {\n    q.tip = q.position;\n    q.width = select(0.12, 0.3, KIND[h] == 3u);\n    q.tint = vec4f(light * ctx.params.lensGain, 1.0);\n  }\n  return q;\n}\n",
