          "presets": "{\n  \"version\": 1,\n  \"presets\": [\n    {\n      \"name\": \"open\",\n      \"values\": {\n        \"layerRings\": {\n          \"opacity\": 1\n        },\n        \"layerGrid\": {\n          \"opacity\": 0\n        },\n        \"layerFx\": {\n          \"opacity\": 0\n        }\n      },\n      \"on\": {\n        \"layerRings\": true,\n        \"layerGrid\": false,\n        \"layerFx\": false\n      },\n      \"recalls\": [\n        {\n          \"bank\": \"looks\",\n          \"preset\": \"dawn\"\n        },\n        {\n          \"bank\": \"fx\",\n          \"preset\": \"clean\"\n        }\n      ],\n      \"morph\": {\n        \"seconds\": 2,\n        \"curve\": \"smooth\"\n      }\n    },\n    {\n      \"name\": \"cross\",\n      \"values\": {\n        \"layerGrid\": {\n          \"opacity\": 1\n        }\n      },\n      \"on\": {\n        \"layerGrid\": true\n      },\n      \"morph\": {\n        \"seconds\": 2,\n        \"curve\": \"smooth\"\n      }\n    },\n    {\n      \"name\": \"drop\",\n      \"values\": {\n        \"layerFx\": {\n          \"opacity\": 0.85\n        }\n      },\n      \"on\": {\n        \"layerRings\": false,\n        \"layerFx\": true\n      },\n      \"recalls\": [\n        {\n          \"bank\": \"looks\",\n          \"preset\": \"riot\"\n        },\n        {\n          \"bank\": \"fx\",\n          \"preset\": \"dirty\"\n        }\n      ]\n    },\n    {\n      \"name\": \"out\",\n      \"values\": {\n        \"layerRings\": {\n          \"opacity\": 1\n        },\n        \"layerGrid\": {\n          \"opacity\": 0\n        },\n        \"layerFx\": {\n          \"opacity\": 0\n        }\n      },\n      \"on\": {\n        \"layerRings\": true\n      },\n      \"recalls\": [\n        {\n          \"bank\": \"looks\",\n          \"preset\": \"dawn\"\n        }\n      ],\n      \"morph\": {\n        \"seconds\": 4,\n        \"curve\": \"smooth\"\n      }\n    }\n  ]\n}\n",
