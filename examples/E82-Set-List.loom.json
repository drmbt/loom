        "parameters": {
          "presets": "{\n  \"version\": 1,\n  \"presets\": [\n    {\n      \"name\": \"dawn\",\n      \"values\": {\n        \"ringsSrc\": {\n          \"period\": 2.5\n        },\n        \"rings\": {\n          \"hueoffset\": 0,\n          \"saturation\": 0.7,\n          \"value\": 1\n        },\n        \"grid\": {\n          \"r\": 0,\n          \"s\": [\n            1,\n            1\n          ]\n        }\n      }\n    },\n    {\n      \"name\": \"noon\",\n      \"values\": {\n        \"ringsSrc\": {\n          \"period\": 5\n        },\n        \"rings\": {\n          \"hueoffset\": 40,\n          \"saturation\": 1.2,\n          \"value\": 1.1\n        },\n        \"grid\": {\n          \"r\": 15,\n          \"s\": [\n            1.5,\n            1.5\n          ]\n        }\n      }\n    },\n    {\n      \"name\": \"riot\",\n      \"values\": {\n        \"ringsSrc\": {\n          \"period\": 9\n        },\n        \"rings\": {\n          \"hueoffset\": 120,\n          \"saturation\": 1.8,\n          \"value\": 1.2\n        },\n        \"grid\": {\n          \"r\": {\n            \"mode\": \"expression\",\n            \"bindings\": {\n              \"static\": {\n                \"kind\": \"static\",\n                \"value\": 45\n              },\n              \"expression\": {\n                \"kind\": \"expression\",\n                \"source\": \"sin(abstime * 0.7) * 45\"\n              }\n            }\n          },\n          \"s\": [\n            0.6,\n            0.6\n          ]\n        }\n      }\n    }\n  ]\n}\n",
