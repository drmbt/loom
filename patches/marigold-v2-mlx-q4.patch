+    /// Explicit loader for the audited mixed Q4/Q8 affine-MLX bundle. Packed
+    /// UInt32 weights remain packed; only floating tensors enter the compute dtype.
+    public func loadMixedQuantizedBaseWeights(shards: [URL], dtype: DType, biasURL: URL) throws {
+        guard [.float16, .bfloat16, .float32].contains(dtype), !shards.isEmpty else {
+            throw MarigoldError.weights("quantized loading requires floating compute dtype and nonempty shards")
+        }
+        let expected = Dictionary(uniqueKeysWithValues: parameters().flattened())
+        let linears = linearsByPath()
+        var tensors: [String: MLXArray] = [:]
+        let replacements = [
+            (".img_mod_linear.", ".img_mod.1."), (".txt_mod_linear.", ".txt_mod.1."),
+            (".img_ff.mlp_in.", ".img_mlp.net.0.proj."), (".img_ff.mlp_out.", ".img_mlp.net.2."),
+            (".txt_ff.mlp_in.", ".txt_mlp.net.0.proj."), (".txt_ff.mlp_out.", ".txt_mlp.net.2."),
+            (".attn.attn_to_out.", ".attn.to_out."),
+        ]
+        for url in shards {
+            for (sourceKey, value) in try MLX.loadArrays(url: url) {
+                var key = sourceKey
+                for (source, target) in replacements { key = key.replacingOccurrences(of: source, with: target) }
+                guard tensors[key] == nil else {
+                    throw MarigoldError.weights("duplicate quantized tensor after audited remapping: \(key)")
+                }
+                tensors[key] = value
+            }
+        }
+        let auxiliary = try MLX.loadArrays(url: biasURL)
+        guard Set(auxiliary.keys) == ["norm_out.linear.bias"], tensors["norm_out.linear.bias"] == nil else {
+            throw MarigoldError.weights("auxiliary must supply only the omitted norm_out.linear.bias")
+        }
+        tensors["norm_out.linear.bias"] = auxiliary["norm_out.linear.bias"]
+
+        var updates: [String: MLXArray] = [:]
+        var states: [String: (MLXArray, MLXArray, Int)] = [:]
+        var consumed = Set<String>()
+        for (key, original) in expected {
+            guard let value = tensors[key] else { throw MarigoldError.weights("missing quantized bundle tensor: \(key)") }
+            consumed.insert(key)
+            if value.dtype == .uint32 {
+                guard key.hasSuffix(".weight"), let linear = linears[String(key.dropLast(7))] else {
+                    throw MarigoldError.weights("packed tensor is not a known linear weight: \(key)")
+                }
+                let path = String(key.dropLast(7))
+                let bits = path.hasSuffix("img_mod.1") ? 8 : 4
+                let scaleKey = path + ".scales", biasKey = path + ".biases"
+                guard let scales = tensors[scaleKey], let biases = tensors[biasKey],
+                    linear.inputDimensions % 64 == 0,
+                    value.shape == [linear.outputDimensions, linear.inputDimensions / (32 / bits)],
+                    scales.shape == [linear.outputDimensions, linear.inputDimensions / 64],
+                    biases.shape == scales.shape, scales.dtype == .bfloat16, biases.dtype == .bfloat16 else {
+                    throw MarigoldError.weights("invalid Q\(bits)/group64 weight, scales or biases for \(path)")
+                }
+                updates[key] = value
+                states[path] = (scales.asType(dtype), biases.asType(dtype), bits)
+                consumed.formUnion([scaleKey, biasKey])
+            } else {
+                guard [.float16, .bfloat16, .float32].contains(value.dtype), value.shape == original.shape else {
+                    throw MarigoldError.weights("floating tensor dtype/shape mismatch for \(key)")
+                }
+                updates[key] = value.dtype == dtype ? value : value.asType(dtype)
+            }
+        }
+        let unused = Set(tensors.keys).subtracting(consumed)
+        guard unused.isEmpty, !states.isEmpty else {
+            throw MarigoldError.weights("unknown bundle tensors or no packed weights: \(unused.sorted().prefix(5))")
+        }
+        // Packed shapes differ deliberately. Every shape was checked above;
+        // retain exact key coverage without the float-shape verification flag.
+        try update(parameters: ModuleParameters.unflattened(updates), verify: [.noUnusedKeys, .allModelKeysSet])
+        for (path, state) in states {
+            linears[path]!.installQuantization(scales: state.0, biases: state.1, bits: state.2)
+        }
+    }
