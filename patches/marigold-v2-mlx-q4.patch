+    public static func loadQuantized(
+        _ config: MarigoldSessionConfig, shards: [URL], normOutBias: URL,
+        progress: ((String) -> Void)? = nil
+    ) throws -> MarigoldSession {
+        guard config.loraMode == .runtime else {
+            throw MarigoldError.weights("quantized sessions require runtime LoRA")
+        }
+        progress?("Loading mixed Q4/Q8 DiT (\(config.ditDType))…")
+        let dit = QwenImageTransformer2DModel(try .load(from: config.assets.transformerConfig))
+        try dit.loadMixedQuantizedBaseWeights(shards: shards, dtype: config.ditDType, biasURL: normOutBias)
+        eval(dit.parameters().flattened().map(\.1) + dit.quantizedArrays)
+        let vae = QwenImageVAE(try .load(from: config.assets.vaeConfig))
+        progress?("Loading checkpoint \(config.checkpoint.name)…")
+        let parts = try CheckpointParts.load(config.checkpoint, config: config)
+        let session = MarigoldSession(config: config, dit: dit, vae: vae, prompt: parts.prompt)
+        try session.install(parts, checkpoint: config.checkpoint)
+        return session
+    }
